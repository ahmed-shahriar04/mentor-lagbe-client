# MentorLagbe Client Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000

# ImgBB API Key (from https://api.imgbb.com)
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key_here

# Stripe Publishable Key (from Stripe Dashboard > Developers > API Keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Better Auth Secret (random 32 bytes)
BETTER_AUTH_SECRET=super_secret_better_auth_session_key
BETTER_AUTH_URL=http://localhost:3000
